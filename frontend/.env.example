# Public Trading Server origin, without credentials. Set before next build.
NEXT_PUBLIC_TRADING_SERVER_URL=http://127.0.0.1:8081
# Member cookie/OAuth flow: use the same site as the Frontend and configured callback.
NEXT_PUBLIC_CONTENT_SERVER_URL=http://localhost:8080
# Owner-approved V2 policy URLs, shown beside the required consent checkboxes when set.
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_PRIVACY_URL=
# The server allows localhost/127.0.0.1:3000 by default.
# For another port (e.g. 3100), override TRADING_HTTP_ALLOWED_ORIGINS and
# TRADING_WS_ALLOWED_ORIGINS with the required comma-separated origins.
