# Public Trading Server origin, without credentials. Set before next build.
NEXT_PUBLIC_TRADING_SERVER_URL=http://127.0.0.1:8081
# The server currently allows localhost/127.0.0.1:5173 by default.
# Run Next on 5173, or include the actual frontend origin in the server's
# TRADING_HTTP_ALLOWED_ORIGINS and TRADING_WS_ALLOWED_ORIGINS environment values.
