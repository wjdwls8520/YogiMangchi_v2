YOGIMANGCHI_DB_USERNAME=yogimangchi_local
YOGIMANGCHI_DB_PASSWORD=change-me
YOGIMANGCHI_DB_PORT=5433

YOGIMANGCHI_REDIS_PORT=6379

# Content authentication: inject actual values locally; never commit private keys or secrets.
CONTENT_SERVER_PORT=8080
CONTENT_JWT_PRIVATE_KEY_PATH=
CONTENT_JWT_KEY_ID=content-1
YOGIMANGCHI_JWT_ISSUER=http://localhost:8080
CONTENT_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
CONTENT_AUTH_RETURN_URI=http://localhost:3000/auth/callback
CONTENT_HTTP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Enable together with Trading member JWT verification; only trusted internal Trading address.
CONTENT_WITHDRAWAL_DELIVERY_ENABLED=false
CONTENT_TRADING_BASE_URL=http://localhost:8081

# prod only: keep app and migration accounts separate. No actual secrets here.
CONTENT_DB_URL=jdbc:postgresql://localhost:5433/yogimangchi
CONTENT_DB_USERNAME=
CONTENT_DB_PASSWORD=
CONTENT_FLYWAY_USERNAME=
CONTENT_FLYWAY_PASSWORD=

# Trading member JWT verification (public key only; never copy the Content private key).
TRADING_MEMBER_AUTH_ENABLED=false
TRADING_JWT_PUBLIC_KEY_PATH=
TRADING_HTTP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRADING_WS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# prod Trading connection and separate migration account
TRADING_DB_URL=jdbc:postgresql://localhost:5433/yogimangchi
TRADING_DB_USERNAME=
TRADING_DB_PASSWORD=
TRADING_FLYWAY_USERNAME=
TRADING_FLYWAY_PASSWORD=
